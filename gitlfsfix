#!/usr/bin/env bash

# One explicit repository-relative filename, never an evaluated pathspec or a
# hardcoded map name. Keep filter-branch's original-ref safety check enabled.
if [[ $# -ne 1 || -z $1 || $1 == /* || $1 == */ || $1 == . || $1 == .. ||
      /$1/ == */../* ]]; then
    printf 'Usage: bash gitlfsfix <repository-relative-file>\n' >&2
    exit 2
fi

# A sentinel preserves trailing newlines instead of silently selecting a sibling
# directory. Remove exactly the sentinel and Git's one output-record newline.
root=$(git rev-parse --show-toplevel && printf '.') || exit
root=${root%.}
root=${root%$'\n'}
# filter-branch also uses newline-stripping $(pwd) internally, so these roots
# cannot be filtered safely even after correcting our own root discovery.
if [[ $root == *$'\n' ]]; then
    printf 'Error: repository roots ending in a newline are unsupported by git filter-branch; refusing to rewrite history.\n' >&2
    exit 2
fi
cd -- "$root" || exit
export GITLFSFIX_TARGET="$1"
git filter-branch --index-filter \
    'git update-index --force-remove -- "$GITLFSFIX_TARGET"' \
    --prune-empty --tag-name-filter cat -- --all
